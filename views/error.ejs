<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erreur - EcoRide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <!--Start header : le menu de le page-->
<%- include('partials/header', { user }) %>

    <!--START BODY-->
    <main>
      <div class="wrapper">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-body text-center">
                            <h1 class="card-title text-danger mb-4">⚠️ Erreur</h1>
                            <% if (typeof message !== 'undefined') { %>
                                <p class="card-text"><%= message %></p>
                            <% } else { %>
                                <p class="card-text">Une erreur inattendue s'est produite.</p>
                            <% } %>
                            <div class="mt-4">
                                <a href="/" class="btn btn-primary me-2">Retour à l'accueil</a>
                                <a href="/trajets" class="btn btn-secondary">Voir les trajets</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </main>
    <!--END BODY-->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
<%- include('partials/footer') %>
</html>
