<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erreur - EcoRide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <!--Start header : le menu de le page-->
<%- include('partials/header', { user }) %>

    <!--START BODY-->
    <main class="d-flex justify-content-center align-items-center vh-100">
        <div class="card p-5 shadow-lg" style="max-width: 600px; width: 100%; background: rgb(80, 178, 163); border-radius: 15px;">
            <div class="card-body text-center">
                <div class="mb-4">
                    <svg width="100" height="100" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-warning">
                        <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 17H11V15H13V17ZM13 13H11V7H13V13Z" fill="currentColor"/>
                    </svg>
                </div>
                <h1 class="card-title text-white mb-4" style="font-size: 2.5rem; font-weight: 700;">Oops !</h1>
                <h2 class="text-white mb-4" style="font-size: 1.5rem;">Une erreur s'est produite</h2>
                <% if (typeof message !== 'undefined') { %>
                    <p class="card-text text-white mb-4" style="font-size: 1.1rem;"><%= message %></p>
                <% } else { %>
                    <p class="card-text text-white mb-4" style="font-size: 1.1rem;">Une erreur inattendue s'est produite. Veuillez réessayer plus tard.</p>
                <% } %>
                <div class="mt-4">
                    <a href="/" class="btn btn-light btn-lg me-4" style="border-radius: 25px; padding: 10px 30px;">🏠 Retour à l'accueil</a>
                    <a href="/trajets" class="btn btn-outline-light btn-lg mt-2" style="border-radius: 25px; padding: 10px 30px;">🚗 Voir les trajets</a>
                </div>
            </div>
        </div>
    </main>
    <!--END BODY-->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
<%- include('partials/footer') %>
</html>
