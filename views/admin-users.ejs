<%- include('partials/header', { title: 'Utilisateurs', user, pageClass: 'users-admin-page' }) %>

<main class="users-page-container">
  <div class="page-header">
    <div class="header-content">
      <div class="title-section">
        <h1 class="page-title">
          <span class="title-icon">👥</span>
          <span>Gestion des utilisateurs</span>
        </h1>
        <p class="page-subtitle">Gérez les comptes utilisateurs de la plateforme</p>
      </div>
      
      <div class="header-stats">
        <div class="stat-item">
          <div class="stat-number"><%= users ? users.length : 0 %></div>
          <div class="stat-label">Total utilisateurs</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= users ? users.filter(u => u.presence === 'online').length : 0 %></div>
          <div class="stat-label">En ligne</div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= users ? users.filter(u => u.suspended).length : 0 %></div>
          <div class="stat-label">Suspendus</div>
        </div>
      </div>
    </div>
  </div>

  <div class="page-content">
    <% if (!users || users.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">👤</div>
        <h3>Aucun utilisateur</h3>
        <p>Il n'y a aucun utilisateur enregistré pour le moment.</p>
      </div>
    <% } else { %>
      <div class="users-table-container">
        <div class="table-header">
          <div class="table-title">
            <h2>Liste des utilisateurs</h2>
            <span class="users-count"><%= users.length %> utilisateur<%= users.length > 1 ? 's' : '' %></span>
          </div>
          
          <div class="table-actions">
            <div class="search-box">
              <input type="text" id="searchUsers" placeholder="Rechercher un utilisateur..." class="form-control">
              <span class="search-icon">🔍</span>
            </div>
            
            <div class="filter-dropdown">
              <select id="roleFilter" class="form-select">
                <option value="">Tous les rôles</option>
                <option value="utilisateur">Utilisateurs</option>
                <option value="employe">Employés</option>
                <option value="admin">Admins</option>
              </select>
            </div>
          </div>
        </div>

        <div class="modern-table">
          <div class="table-responsive">
            <table class="table" id="usersTable">
              <thead>
                <tr>
                  <th>Utilisateur</th>
                  <th>Rôle</th>
                  <th>Activité</th>
                  <th>Crédits</th>
                  <th>Statut</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(u => { %>
                  <tr class="user-row" data-role="<%= u.role === 'passager' || u.role === 'chauffeur' ? 'utilisateur' : u.role %>">
                    <td>
                      <div class="user-info">
                        <div class="user-avatar">
                          <%= (u.prenom || 'U')[0].toUpperCase() %>
                        </div>
                        <div class="user-details">
                          <div class="user-name"><%= u.prenom %> <%= u.nom %></div>
                          <div class="user-email"><%= u.email %></div>
                        </div>
                      </div>
                    </td>
                    
                    <td>
                      <span class="role-badge role-<%= u.role === 'passager' || u.role === 'chauffeur' ? 'user' : u.role %>">
                        <%= (u.role === 'passager' || u.role === 'chauffeur') ? 'Utilisateur' : u.role.charAt(0).toUpperCase() + u.role.slice(1) %>
                      </span>
                    </td>
                    
                    <td>
                      <div class="activity-info">
                        <div class="activity-item">
                          <span class="activity-icon">🚗</span>
                          <span><%= u.nb_trajets_crees || 0 %> trajets</span>
                        </div>
                        <div class="activity-item">
                          <span class="activity-icon">📅</span>
                          <span><%= u.nb_reservations || 0 %> réservations</span>
                        </div>
                      </div>
                    </td>
                    
                    <td>
                      <div class="credits-display">
                        <span class="credits-icon">💰</span>
                        <span class="credits-amount"><%= u.credits || 0 %></span>
                      </div>
                    </td>
                    
                    <td>
                      <div class="status-container">
                        <div class="presence-status <%= u.presence === 'online' ? 'online' : 'offline' %>">
                          <div class="status-dot"></div>
                          <span><%= u.presence === 'online' ? 'En ligne' : 'Hors ligne' %></span>
                        </div>
                        <% if (u.suspended) { %>
                          <div class="suspended-badge">Suspendu</div>
                        <% } %>
                      </div>
                    </td>
                    
                  </td>
                  <td class="text-end">
                    <form action="/admin/users/<%= u.id %>/suspend" method="post" class="d-inline">
                      <button class="btn btn-sm <%= u.suspended ? 'btn-success' : 'btn-warning' %>">
                        <%= u.suspended ? 'Réactiver' : 'Suspendre' %>
                      </button>
                    </form>
                  </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>

<script>
// Fonction de confirmation
function confirmAction(action) {
  return confirm(action + ' ce compte ?');
}

// Recherche en temps réel
document.getElementById('searchUsers')?.addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const rows = document.querySelectorAll('#usersTable tbody tr');
  
  rows.forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(searchTerm) ? '' : 'none';
  });
});

// Filtrage par rôle
document.getElementById('roleFilter')?.addEventListener('change', function(e) {
  const selectedRole = e.target.value;
  const rows = document.querySelectorAll('.user-row');
  
  rows.forEach(row => {
    const userRole = row.dataset.role;
    row.style.display = !selectedRole || userRole === selectedRole ? '' : 'none';
  });
});

// Animation d'entrée des lignes
document.addEventListener('DOMContentLoaded', function() {
  const rows = document.querySelectorAll('.user-row');
  rows.forEach((row, index) => {
    row.style.opacity = '0';
    row.style.transform = 'translateY(20px)';
    setTimeout(() => {
      row.style.transition = 'all 0.4s ease';
      row.style.opacity = '1';
      row.style.transform = 'translateY(0)';
    }, index * 50);
  });
});

// Fonction pour afficher les détails (à implémenter)
function showUserDetails(userId) {
  alert('Fonctionnalité à implémenter : détails de l\'utilisateur ' + userId);
}
</script>

<style>
