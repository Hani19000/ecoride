<%- include('partials/header', { title: 'Mon profil', user }) %>

<!-- PAGE PROFIL -->
<div class="profile-page">
  <main class="container-xl py-5">

    <% if (!user) { %>
      <div class="alert alert-danger text-center">
        Aucune donnée utilisateur disponible. Veuillez vous reconnecter.
      </div>
    <% } else { %>

      <!-- Bandeau + avatar -->
      <section class="hero card border-0 shadow-sm mb-4">
        <div class="hero-inner">
          <img src="https://www.w3schools.com/howto/img_avatar.png" alt="Avatar" class="avatar shadow">
          <h2 class="mt-3 mb-1"><%= user.nom %> <%= user.prenom %></h2>
          <p class="text-muted m-0"><%= user.role || "Conducteur & Passager" %></p>
        </div>
      </section>

      <!-- Grid infos -->
      <section class="row g-4">
        <div class="col-lg-6">
          <div class="card card-soft p-3 h-100">
            <h5 class="fw-bold mb-3">Informations</h5>
            <div class="row g-2 small">
              <div class="col-6"><span class="text-muted">Email</span><div class="fw-semibold"><%= user.email %></div></div>
              <div class="col-6"><span class="text-muted">Membre depuis</span><div class="fw-semibold"><%= user.created_at || "N/A" %></div></div>
              <div class="col-6"><span class="text-muted">Ville</span><div class="fw-semibold"><%= user.ville %><%= user.departement ? (", " + user.departement) : "" %></div></div>
              <div class="col-6"><span class="text-muted">Crédits</span><div class="fw-semibold"><%= user.credits ?? 20 %> crédits</div></div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="card card-soft p-3 h-100">
            <h5 class="fw-bold mb-3">Statistiques</h5>
            <div class="row g-2 small">
              <div class="col-6"><span class="text-muted">Trajets effectués</span><div class="fw-semibold"><%= user.trajets || 0 %></div></div>
              <div class="col-6"><span class="text-muted">Avis moyen</span><div class="fw-semibold"><%= user.avis ? ("⭐".repeat(Math.round(user.avis)) + " (" + user.avis + "/5)") : "—" %></div></div>
              <div class="col-12"><span class="text-muted">Véhicule</span><div class="fw-semibold"><%= user.voiture || "Non renseigné" %></div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Derniers trajets -->
      <section class="card card-soft p-3 mt-4">
        <div class="d-flex align-items-center justify-content-between">
          <h5 class="fw-bold mb-0">Derniers trajets</h5>
          <a href="/historique" class="btn btn-outline-dark btn-sm">📋 Voir l’historique complet</a>
        </div>

        <% if (!reservations || reservations.length === 0) { %>
          <p class="text-center text-muted my-4">Aucun trajet réservé pour l’instant.</p>
        <% } else { %>
          <div class="table-responsive mt-3">
            <table class="table table-bordered align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>🛫 Départ</th>
                  <th>🛬 Destination</th>
                  <th>📅 Date</th>
                  <th>🕒 Heure</th>
                  <th>💳 Crédits</th>
                  <th>✅ Statut</th>
                </tr>
              </thead>
              <tbody>
                <% reservations.forEach(res => { %>
                  <tr>
                    <td><%= res.lieu_depart %></td>
                    <td><%= res.destination %></td>
                    <td><%= new Date(res.date_du_trajet).toLocaleDateString() %></td>
                    <td><%= res.heure_depart %></td>
                    <td><span class="badge bg-success"><%= res.credits_utilises %> crédits</span></td>
                    <td><span class="badge bg-info text-dark"><%= res.statut %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <!-- Paramètres -->
      <section class="card card-soft p-3 mt-4">
        <h5 class="fw-bold mb-3">Paramètres du compte</h5>
        <form action="/update-role" method="POST" class="d-flex align-items-center flex-wrap gap-3">
          <div>
            <label class="form-label mb-1">Sélectionnez votre rôle :</label>
            <div class="d-flex align-items-center gap-3">
              <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" id="roleChauffeur" name="role[]" value="chauffeur"
                       <%= user.role && user.role.includes('chauffeur') ? 'checked' : '' %>>
                <label class="form-check-label" for="roleChauffeur">Chauffeur</label>
              </div>
              <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" id="rolePassager" name="role[]" value="passager"
                       <%= user.role && user.role.includes('passager') ? 'checked' : '' %>>
                <label class="form-check-label" for="rolePassager">Passager</label>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Mettre à jour</button>
        </form>
      </section>

      <!-- Véhicule (affiché si "chauffeur") -->
      <section id="chauffeurDetails"
               class="card card-soft p-3 mt-4 <%= user.role && user.role.includes('chauffeur') ? '' : 'd-none' %>">
        <h5 class="fw-bold mb-3">Informations véhicule</h5>
        <form id="vehicleForm" action="/details" method="POST" class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Plaque d'immatriculation</label>
            <input type="text" name="plaque_immatriculation" class="form-control" placeholder="AB-123-CD" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Date de première immatriculation</label>
            <input type="date" name="date_premiere_immatriculation" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Marque</label>
            <input type="text" name="marque" class="form-control" placeholder="Peugeot">
          </div>
          <div class="col-md-6">
            <label class="form-label">Modèle</label>
            <input type="text" name="modele" class="form-control" placeholder="208">
          </div>
          <div class="col-md-6">
            <label class="form-label">Couleur</label>
            <input type="text" name="couleur" class="form-control" placeholder="Bleu">
          </div>
          <div class="col-md-6">
            <label class="form-label">Nombre de places disponibles</label>
            <input type="number" name="nombre_places_disponibles" min="1" class="form-control" placeholder="4">
          </div>
          <div class="col-12">
            <h6 class="mb-2">Préférences</h6>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="preferences" value="fumeur"
                     <%= user.preferences && user.preferences.includes('fumeur') ? 'checked' : '' %>>
              <label class="form-check-label">Fumeur</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="preferences" value="animal"
                     <%= user.preferences && user.preferences.includes('animal') ? 'checked' : '' %>>
              <label class="form-check-label">Animaux</label>
            </div>
          </div>
          <div class="col-12">
            <button class="btn btn-primary">Enregistrer</button>
          </div>
        </form>
      </section>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>

<!-- STYLES SPÉCIFIQUES À LA PAGE PROFIL (scopés pour éviter d’impacter le reste) -->
<style>
  .profile-page {
    background: #00ffbf; /* fond plein écran */
    min-height: 100vh;
  }
  .profile-page .card-soft {
    background: rgb(80, 178, 163);
    border: 0;
    border-radius: 18px;
  }
  .hero {
    background: linear-gradient(135deg, #06df8c, #35a181);
    border-radius: 18px;
  }
  .hero-inner {
    padding: 2rem 1rem;
    text-align: center;
  }
  .avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 5px solid #fff;
    object-fit: cover;
  }
</style>

<!-- JS : toggle section véhicule quand on coche “Chauffeur” -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const roleChauffeur = document.getElementById('roleChauffeur');
    const chauffeurDetails = document.getElementById('chauffeurDetails');

    if (roleChauffeur && chauffeurDetails) {
      roleChauffeur.addEventListener('change', () => {
        chauffeurDetails.classList.toggle('d-none', !roleChauffeur.checked);
      });
    }
  });
</script>
