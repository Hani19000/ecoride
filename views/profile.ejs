<%- include('partials/header', { title: 'Mon profil', user }) %>

<!-- PAGE PROFIL -->
<div class="profile-page">
  <main class="container-xl py-5">

    <% if (!user) { %>
      <div class="alert alert-danger text-center">
        Aucune donnée utilisateur disponible. Veuillez vous reconnecter.
      </div>
    <% } else { %>

      <!-- Bandeau + avatar -->
      <section class="hero card border-0 shadow-sm mb-4">
        <div class="hero-inner">
          <img src="https://www.w3schools.com/howto/img_avatar.png" alt="Avatar" class="avatar shadow">
          <h2 class="mt-3 mb-1"><%= user.nom %> <%= user.prenom %></h2>
          <p class="text-muted m-0"><%= user.role || "Conducteur & Passager" %></p>
        </div>
      </section>

      <!-- Grid infos -->
      <section class="row g-4">
        <div class="col-lg-6">
          <div class="card card-soft p-4 h-100">
            <div class="section-header mb-3">
              <h5 class="fw-bold text-white mb-0">
                <i class="bi bi-person-circle me-2"></i>Informations
              </h5>
            </div>
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">Email</span>
                <div class="info-value"><%= user.email %></div>
              </div>
              <div class="info-item">
                <span class="info-label">Membre depuis</span>
                <div class="info-value"><%= user.created_at || "N/A" %></div>
              </div>
              <div class="info-item">
                <span class="info-label">Ville</span>
                <div class="info-value"><%= user.ville %><%= user.departement ? (", " + user.departement) : "" %></div>
              </div>
              <div class="info-item">
                <span class="info-label">Crédits</span>
                <div class="info-value"><%= user.credits ?? 20 %> crédits</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="card card-soft p-4 h-100">
            <div class="section-header mb-3">
              <h5 class="fw-bold text-white mb-0">
                <i class="bi bi-graph-up me-2"></i>Statistiques
              </h5>
            </div>
            <div class="stats-container">
              <div class="row g-3">
                <div class="col-6">
                  <div class="stats-card">
                    <span class="stats-number"><%= user.trajets || 0 %></span>
                    <span class="stats-label">Trajets effectués</span>
                  </div>
                </div>
                <div class="col-6">
                  <div class="stats-card">
                    <span class="stats-number">
                      <% if (user.avis) { %>
                        <%= user.avis %>★
                      <% } else { %>
                        —
                      <% } %>
                    </span>
                    <span class="stats-label">Avis moyen</span>
                  </div>
                </div>
                <div class="col-12">
                  <div class="info-item mt-2">
                    <span class="info-label">Véhicule</span>
                    <div class="info-value"><%= user.voiture || "Non renseigné" %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Derniers trajets -->
      <section class="card card-soft p-4 mt-4">
        <div class="section-header">
          <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-clock-history me-2"></i>Derniers trajets
          </h5>
          <a href="/historique" class="btn btn-outline-light btn-sm">
            <i class="bi bi-list-ul me-1"></i>Voir l'historique complet
          </a>
        </div>

        <% if (!reservations || reservations.length === 0) { %>
          <div class="empty-state">
            <i class="bi bi-car-front"></i>
            <h6 class="text-white mt-3">Aucun trajet pour l'instant</h6>
            <p class="text-white-50 mb-0">Vos prochaines réservations apparaîtront ici.</p>
          </div>
        <% } else { %>
          <div class="table-container mt-3">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th><i class="bi bi-geo-alt me-1"></i>Départ</th>
                  <th><i class="bi bi-flag me-1"></i>Destination</th>
                  <th><i class="bi bi-calendar me-1"></i>Date</th>
                  <th><i class="bi bi-clock me-1"></i>Heure</th>
                  <th><i class="bi bi-coin me-1"></i>Crédits</th>
                  <th><i class="bi bi-check-circle me-1"></i>Statut</th>
                </tr>
              </thead>
              <tbody>
                <% reservations.forEach(res => { %>
                  <tr>
                    <td><strong><%= res.lieu_depart %></strong></td>
                    <td><strong><%= res.destination %></strong></td>
                    <td><%= new Date(res.date_du_trajet).toLocaleDateString() %></td>
                    <td><%= res.heure_depart %></td>
                    <td><span class="badge bg-success"><%= res.credits_utilises %> crédits</span></td>
                    <td><span class="badge bg-info text-dark"><%= res.statut %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <!-- Paramètres -->
      <section class="card card-soft p-4 mt-4">
        <div class="section-header mb-3">
          <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-gear me-2"></i>Paramètres du compte
          </h5>
        </div>
        <form action="/update-role" method="POST" class="role-form">
          <div class="row align-items-end g-3">
            <div class="col-md-8">
              <label class="form-label text-white mb-2">Sélectionnez votre rôle :</label>
              <div class="d-flex align-items-center gap-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="roleChauffeur" name="role[]" value="chauffeur"
                         <%= user.role && user.role.includes('chauffeur') ? 'checked' : '' %>>
                  <label class="form-check-label text-white" for="roleChauffeur">
                    <i class="bi bi-steering-wheel me-1"></i>Chauffeur
                  </label>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check-lg me-1"></i>Mettre à jour
              </button>
            </div>
          </div>
        </form>
      </section>

      <!-- Véhicule (affiché si "chauffeur") -->
      <section id="chauffeurDetails"
               class="card card-soft p-4 mt-4 <%= user.role && user.role.includes('chauffeur') ? '' : 'd-none' %>">
        <div class="section-header mb-3">
          <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-car-front me-2"></i>Informations véhicule
          </h5>
        </div>
        <form id="vehicleForm" action="/details" method="POST" class="row g-3">
          <div class="col-md-4">
            <label class="form-label text-white">Plaque d'immatriculation</label>
            <input type="text" name="plaque_immatriculation" class="form-control" placeholder="AB-123-CD" required>
          </div>
          <div class="col-md-4">
            <label class="form-label text-white">Date de première immatriculation</label>
            <input type="date" name="date_premiere_immatriculation" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label text-white">Marque</label>
            <input type="text" name="marque" class="form-control" placeholder="Peugeot">
          </div>
          <div class="col-md-6">
            <label class="form-label text-white">Modèle</label>
            <input type="text" name="modele" class="form-control" placeholder="208">
          </div>
          <div class="col-md-6">
            <label class="form-label text-white">Couleur</label>
            <input type="text" name="couleur" class="form-control" placeholder="Bleu">
          </div>
          <div class="col-md-6">
            <label class="form-label text-white">Nombre de places disponibles</label>
            <input type="number" name="nombre_places_disponibles" min="1" class="form-control" placeholder="4">
          </div>
          <div class="col-12">
            <h6 class="text-white mb-3">Préférences</h6>
            <div class="row g-2">
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="preferences" value="fumeur"
                         <%= user.preferences && user.preferences.includes('fumeur') ? 'checked' : '' %>>
                  <label class="form-check-label text-white">
                    <i class="bi bi-flower1 me-1"></i>Fumeur autorisé
                  </label>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="preferences" value="animal"
                         <%= user.preferences && user.preferences.includes('animal') ? 'checked' : '' %>>
                  <label class="form-check-label text-white">
                    <i class="bi bi-heart me-1"></i>Animaux autorisés
                  </label>
                </div>
              </div>
            </div>
          </div>
          <div class="col-12">
            <button class="btn btn-primary">
              <i class="bi bi-save me-1"></i>Enregistrer
            </button>
          </div>
        </form>
      </section>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>

<!-- STYLES AMÉLIORÉS POUR LA PAGE PROFIL -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
  :root {
    --primary-color: #06df8c;
    --secondary-color: #35a181;
    --card-bg: rgba(80, 178, 163, 0.9);
    --text-dark: #2c3e50;
    --border-radius: 18px;
    --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    --shadow-hover: 0 8px 25px rgba(0, 0, 0, 0.15);
    --transition: all 0.3s ease;
  }

  .profile-page {
    background: #00ffbf;
    min-height: 100vh;
  }

  .card-soft {
    background: var(--card-bg);
    border: 0;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    transition: var(--transition);
    backdrop-filter: blur(10px);
  }

  .card-soft:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }

  .hero {
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    border-radius: var(--border-radius);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
    z-index: 1;
  }

  .hero-inner {
    padding: 3rem 1rem;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 5px solid rgba(255, 255, 255, 0.8);
    object-fit: cover;
    box-shadow: var(--shadow);
    transition: var(--transition);
  }

  .avatar:hover {
    transform: scale(1.05);
  }

  .hero h2 {
    color: white;
    font-weight: 700;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .hero p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.1rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: between;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
  }

  .info-item {
    text-align: center;
    padding: 1rem 0.5rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    transition: var(--transition);
  }

  .info-item:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  .info-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.25rem;
    display: block;
  }

  .info-value {
    font-weight: 600;
    color: white;
    font-size: 0.95rem;
  }

  .stats-card {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.5rem 1rem;
    text-align: center;
    transition: var(--transition);
    height: 100%;
  }

  .stats-card:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .stats-number {
    font-size: 2rem;
    font-weight: 700;
    color: white;
    display: block;
    line-height: 1;
  }

  .stats-label {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 0.5rem;
  }

  .table-container {
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .table {
    margin: 0;
  }

  .table th {
    background: var(--secondary-color);
    color: white;
    border: none;
    font-weight: 600;
    padding: 1rem 0.75rem;
  }

  .table td {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 255, 255, 0.3);
    vertical-align: middle;
    padding: 1rem 0.75rem;
  }

  .table tbody tr:hover td {
    background: rgba(255, 255, 255, 1);
  }

  .badge {
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
  }

  .btn {
    border-radius: 25px;
    font-weight: 500;
    padding: 0.6rem 1.5rem;
    transition: var(--transition);
    border: none;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .btn-primary {
    background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
    color: white;
  }

  .btn-outline-light {
    border: 2px solid rgba(255, 255, 255, 0.7);
    color: white;
    background: transparent;
  }

  .btn-outline-light:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: white;
    color: white;
  }

  .form-control, .form-select {
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.9);
    transition: var(--transition);
    padding: 0.75rem 1rem;
  }

  .form-control:focus, .form-select:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 0.2rem rgba(6, 223, 140, 0.25);
    background: white;
  }

  .form-check-input {
    border-radius: 4px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.9);
  }

  .form-check-input:checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
  }

  .form-check-input:focus {
    box-shadow: 0 0 0 0.2rem rgba(6, 223, 140, 0.25);
  }

  .form-label {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .alert {
    border-radius: var(--border-radius);
    border: none;
    box-shadow: var(--shadow);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .empty-state i {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.6;
    color: white;
  }

  .role-form {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.5rem;
  }

  /* Animations */
  .card-soft {
    animation: fadeInUp 0.6s ease-out;
  }

  .card-soft:nth-child(1) { animation-delay: 0.1s; }
  .card-soft:nth-child(2) { animation-delay: 0.2s; }
  .card-soft:nth-child(3) { animation-delay: 0.3s; }
  .card-soft:nth-child(4) { animation-delay: 0.4s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-inner {
      padding: 2rem 1rem;
    }

    .avatar {
      width: 100px;
      height: 100px;
    }

    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .section-header {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .table-responsive {
      font-size: 0.9rem;
    }
  }
</style>

<!-- JS : toggle section véhicule quand on coche "Chauffeur" -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const roleChauffeur = document.getElementById('roleChauffeur');
    const chauffeurDetails = document.getElementById('chauffeurDetails');

    if (roleChauffeur && chauffeurDetails) {
      roleChauffeur.addEventListener('change', () => {
        chauffeurDetails.classList.toggle('d-none', !roleChauffeur.checked);
      });
    }
  });
</script>