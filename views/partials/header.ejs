<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="utf-8" />
  <title><%= typeof title !== 'undefined' ? title : 'EcoRide' %></title>
  
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Fonts + Bootstrap -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <style>
    body { font-family: 'Poppins', sans-serif; background-color: #00ffbf; }
    /* Fond plein écran pour les pages employé */
    .bg-eco { background: #00ffbf; }
    .main-fill { min-height: calc(100vh - 200px); }
    .navbar-brand { font-weight: 700; }
  </style>
</head>

<body class="<%= (typeof pageClass !== 'undefined' ? pageClass : '') %>">
<header>
  <nav class="navbar navbar-expand-lg navbar-light" style="background-color: rgb(80,178,163);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">EcoRide</a>
      
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"
              aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <div class="collapse navbar-collapse" id="topNav">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <% if (user && user.role === 'admin') { %>
            <!-- Navigation Admin uniquement -->
            <li class="nav-item">
              <a class="nav-link" href="/admin">Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/utilisateurs">Utilisateurs</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Déconnexion</a>
            </li>
          <% } else if (user && user.role === 'employe') { %>
            <!-- Navigation Employé -->
            <li class="nav-item"><a class="nav-link" href="/employe/avis">Avis</a></li>
            <li class="nav-item"><a class="nav-link" href="/employe/incidents">Incidents</a></li>
            <li class="nav-item"><a class="nav-link" href="/logout">Déconnexion</a></li>
          <% } else if (user) { %>
            <!-- Navigation Utilisateur normal -->
            <li class="nav-item"><a class="nav-link" href="/">Accueil</a></li>
            <li class="nav-item"><a class="nav-link" href="/trajets">Covoiturage</a></li>
            <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
            <li class="nav-item"><a class="nav-link" href="/mes-trajets">Mes trajets</a></li>
            <li class="nav-item"><a class="nav-link" href="/profile">Profil</a></li>
            <li class="nav-item">
              <span class="nav-link">
                <i class="fas fa-coins text-warning me-1"></i><%= user.credits %> crédits
              </span>
            </li>
            <li class="nav-item"><a class="nav-link" href="/logout">Déconnexion</a></li>
          <% } else { %>
            <!-- Navigation visiteur -->
            <li class="nav-item"><a class="nav-link" href="/">Accueil</a></li>
            <li class="nav-item"><a class="nav-link" href="/trajets">Covoiturage</a></li>
            <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
            <li class="nav-item"><a class="nav-link" href="/login">Connexion</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
</header>

<!-- Bootstrap bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const navbarCollapse = document.querySelector('.navbar-collapse');
  const navLinks = document.querySelectorAll('.navbar-nav .nav-link');

  // Crée l'instance Collapse sans toggle automatique
  const bsCollapse = new bootstrap.Collapse(navbarCollapse, { toggle: false });

  // Fermer le menu burger quand on clique sur un lien (mobile)
  navLinks.forEach(link => {
    link.addEventListener('click', function() {
      if (window.innerWidth < 992) { // correspond à lg de Bootstrap
        bsCollapse.hide();
      }
    });
  });
});
</script>


</script>
</document_content>
</document>