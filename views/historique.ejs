<%- include('partials/header') %>

<style>
  body {
    background: #00ffbf;
    font-family: 'Poppins', sans-serif;
    min-height: 100vh;
    margin: 0;
  }
  .historique-container {
    max-width: 950px;
    margin: 60px auto;
    padding: 2rem;
    background: rgb(80, 178, 163);
    border-radius: 1.5rem;
    box-shadow: 0 8px 24px rgba(0, 200, 255, 0.2);
  }
  h2 {
    text-align: center;
    margin-bottom: 2rem;
    color: #000000;
    font-weight: 700;
  }
  .reservation-card {
    background: #f7fdfa;
    border-left: 6px solid #00ffbf;
    padding: 1.2rem 1.5rem;
    border-radius: 1rem;
    margin-bottom: 1.2rem;
    box-shadow: 0 4px 8px rgba(0,0,0,0.06);
    transition: transform 0.2s;
  }
  .reservation-card:hover {
    transform: translateY(-3px);
  }
  .reservation-card h5 {
    margin: 0;
    font-size: 1.2rem;
    color: #007a74;
    font-weight: 600;
  }
  .reservation-card p {
    margin: 6px 0;
    font-size: 1rem;
    color: #444;
  }
  .statut {
    display: inline-block;
    background: #00ffbf;
    color: white;
    font-size: 0.9rem;
    padding: 4px 12px;
    border-radius: 20px;
    margin-top: 8px;
    font-weight: 500;
  }
</style>

<div class="wrapper">
  <div class="historique-container">
    <h2>🕓 Historique de vos trajets</h2>

<% reservations.forEach(r => { %>
  <div class="reservation-card">
    <h5><%= r.lieu_depart %> ➜ <%= r.destination %></h5>
    <p><strong>Date :</strong> <%= new Date(r.date_du_trajet).toLocaleDateString() %></p>
    <p><strong>Heure :</strong> <%= (r.heure_depart || '').toString().slice(0,5) %></p>
    <p><strong>Crédits utilisés :</strong> <%= r.credits_utilises %> crédits</p>
    <span class="statut"><%= r.statut %></span>

    <!-- Annuler ma réservation (si tu veux laisser l'option pour les résas non terminées) -->
    <% if (r.statut !== 'termine') { %>
      <form action="/annuler-reservation" method="POST" onsubmit="return confirm('Annuler VOTRE réservation ? Vous serez remboursé.');">
        <input type="hidden" name="trajet_id" value="<%= r.trajet_id %>">
        <button type="submit" class="btn btn-outline-danger btn-sm mt-2">↩️ Annuler ma réservation</button>
      </form>
    <% } %>

    <!-- Formulaire d’avis : seulement si résa terminée et pas encore d’avis -->
<% if (r.statut === 'termine' && !r._avis_deja_donne) { %>
  <form class="avis-form mt-3 p-3 rounded shadow-sm" style="background:#f8fdfc;">
    <input type="hidden" name="reservation_id" value="<%= r.reservation_id %>">
    <input type="hidden" name="trajet_id" value="<%= r.trajet_id %>">

    <div class="mb-2">
      <label class="form-label fw-bold">Note :</label>
      <div class="star-rating" style="font-size:1.7rem; cursor:pointer; user-select:none;">
        <% for (let i = 1; i <= 5; i++) { %>
          <span class="star" data-value="<%= i %>">☆</span>
        <% } %>
        <input type="hidden" name="note" required>
      </div>
    </div>

    <div class="mb-2">
      <label class="form-label fw-bold">Commentaire :</label>
      <textarea name="commentaire" class="form-control" placeholder="Partagez votre expérience..." rows="2"></textarea>
      <div class="form-text">Si la note ≤ 3, un commentaire est requis.</div>
    </div>

    <button type="submit" class="btn btn-success w-100">Envoyer l'avis ✅</button>
    <div class="alert mt-3 d-none confirmation-msg" role="alert"></div>
  </form>
<% } %>
  </div>
<% }) %>
  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function() {
  // étoiles
  document.querySelectorAll(".star-rating").forEach(rating => {
    const stars = rating.querySelectorAll(".star");
    const input = rating.querySelector("input[name='note']");

    function paint(upto) {
      stars.forEach(s => {
        const v = Number(s.dataset.value);
        s.textContent = v <= upto ? '★' : '☆';
      });
    }
    paint(0);

    stars.forEach(star => {
      star.addEventListener("mouseover", () => paint(Number(star.dataset.value)));
      star.addEventListener("mouseout",  () => paint(Number(input.value || 0)));
      star.addEventListener("click",     () => {
        input.value = star.dataset.value;
        paint(Number(input.value));
      });
    });
  });

  // submit AJAX
  document.querySelectorAll(".avis-form").forEach(form => {
    form.addEventListener("submit", async function(e) {
      e.preventDefault();
      const msg = this.querySelector(".confirmation-msg");
      msg.classList.add("d-none");
      msg.classList.remove("alert-success","alert-danger");

      const fd = new FormData(this);
      const note = parseInt(fd.get("note"), 10);
      if (!Number.isInteger(note) || note < 1 || note > 5) {
        msg.textContent = "Choisis une note en cliquant sur une étoile.";
        msg.classList.remove("d-none");
        msg.classList.add("alert","alert-danger");
        return;
      }

      const payload = Object.fromEntries(fd.entries());

      try {
        const res = await fetch("/avis", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          msg.textContent = data.message || "Avis envoyé, merci !";
          msg.classList.remove("d-none");
          msg.classList.add("alert","alert-success");
          this.querySelector("button[type='submit']").disabled = true;
          setTimeout(() => this.remove(), 1200);
        } else {
          msg.textContent = data.message || "Erreur lors de l'envoi.";
          msg.classList.remove("d-none");
          msg.classList.add("alert","alert-danger");
        }
      } catch(err) {
        console.error("Erreur envoi avis :", err);
        msg.textContent = "Erreur réseau, réessayez.";
        msg.classList.remove("d-none");
        msg.classList.add("alert","alert-danger");
      }
    });
  });
});
</script>

<%- include('partials/footer') %>
