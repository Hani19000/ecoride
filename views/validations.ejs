<%- include('partials/header', { title: 'Valider mes trajets', user }) %>
<main class="container" style="padding:120px 16px 32px;">
  <h1 class="mb-4">Valider mes covoit’ terminés</h1>
  <% if (query?.success) { %><div class="alert alert-success"><%= query.success %></div><% } %>
  <% if (query?.error) { %><div class="alert alert-danger"><%= query.error %></div><% } %>

  <% if (!items || items.length === 0) { %>
    <div class="alert alert-info">Aucun trajet à valider.</div>
  <% } %>

  <% items.forEach(it => { %>
    <div class="card mb-3">
      <div class="card-body">
        <h5><%= it.lieu_depart %> → <%= it.destination %></h5>
        <p class="mb-2"><strong>Date :</strong> <%= new Date(it.date_du_trajet).toLocaleDateString() %> à <%= (it.heure_depart || '').toString().slice(0,5) %></p>
        <p class="mb-3"><strong>Crédits utilisés :</strong> <%= it.credits_utilises %></p>

        <form action="/avis" method="POST" class="d-flex flex-wrap gap-2 align-items-start">
          <input type="hidden" name="reservation_id" value="<%= it.reservation_id %>">
          <input type="hidden" name="trajet_id" value="<%= it.trajet_id %>">
          <input type="hidden" name="chauffeur_id" value="<%= it.chauffeur_id %>">

          <div style="max-width:120px">
            <label class="form-label">Note (1-5)</label>
            <input class="form-control form-control-sm" type="number" name="note" min="1" max="5" required>
          </div>

          <div class="flex-grow-1">
            <label class="form-label">Commentaire (obligatoire si note ≤ 3)</label>
            <input class="form-control form-control-sm" type="text" name="commentaire" placeholder="Comment s'est passé le trajet ?">
          </div>

          <button class="btn btn-primary btn-sm">Envoyer mon avis</button>
        </form>
      </div>
    </div>
  <% }) %>
</main>
<%- include('partials/footer') %>
