<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <title>covoiturage</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="style.css" />
    <script src="app.js"></script>
</head>

<body>
    <!--Start header : le menu de le page-->
<%- include('partials/header', { user }) %>

        
    <!--End header-->

    <!--START BODY-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <main class="d-flex justify-content-center align-items-center vh-100">
        <div class="card p-4 shadow-lg" style="max-width: 450px; width: 100%;">
            <h2 class="text-center mb-4">Contactez-nous</h2>
            <form action="/contact" method="POST">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">Adresse Mail</label>
                    <input type="email" class="form-control" id="inputEmail" name="email" required>
                </div>
    
                <div class="mb-3">
                    <label for="inputMessage" class="form-label">Votre Message</label>
                    <textarea class="form-control" id="inputMessage" name="message" rows="4" required></textarea>
                </div>
    
                <button type="submit" class="btn btn-primary w-100">Envoyer</button>
            </form>
        </div>
    </main>
    
    <style>
        body {
            background: #0c0c0c;
        }
    
        .card {
            background: rgb(80, 178, 163);
            border-radius: 10px;
        }
    
        .form-control {
            border-radius: 5px;
        }
    
        .btn-primary {
            background-color: #007bff;
            border: none;
        }
    
        .btn-primary:hover {
            background-color: #0056b3;
        }
    </style>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!--END BODY-->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
<%- include('partials/footer') %>
</html>