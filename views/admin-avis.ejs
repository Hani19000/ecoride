<%- include('partials/header', { title: 'Gestion des avis', user: user }) %>

<div class="admin-page">
  <main class="container-fluid admin-avis-main py-5">
    <div class="container">
      <h1 class="fw-bold mb-4 d-flex align-items-center gap-2" style="color:rgb(80,178,163);">
        <span style="font-size:1.6rem;">🗂️</span> Gestion des avis
      </h1>

      <% if (query && query.success) { %>
        <div class="alert alert-success"><%= query.success %></div>
      <% } %>
      <% if (query && query.error) { %>
        <div class="alert alert-danger"><%= query.error %></div>
      <% } %>

      <div class="card shadow-sm border-0">
        <div class="card-body p-0">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Trajet</th>
                <th>Note</th>
                <th>Commentaire</th>
                <th>Passager</th>
                <th>Statut</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!avis || avis.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">
                    Aucun avis pour le moment.
                  </td>
                </tr>
              <% } else { %>
                <% avis.forEach(a => { %>
                  <tr>
                    <td><%= a.lieu_depart %> ➜ <%= a.destination %></td>
                    <td>
                      <% for(let i=1;i<=a.note;i++){ %>⭐<% } %>
                    </td>
                    <td><%= a.commentaire || "—" %></td>
                    <td><%= a.passager_nom %> <%= a.passager_prenom %></td>
                    <td>
                      <span class="badge <%= a.statut_validation==='en_attente' ? 'bg-warning' : (a.statut_validation==='approuve' ? 'bg-success' : 'bg-danger') %>">
                        <%= a.statut_validation %>
                      </span>
                    </td>
                    <td class="text-end">
                      <% if (a.statut_validation === 'en_attente') { %>
                        <form action="/admin/avis/valider" method="POST" class="d-inline">
                          <input type="hidden" name="avis_id" value="<%= a._id %>">
                          <input type="hidden" name="action" value="approuver">
                          <button class="btn btn-success btn-sm">✅ Approuver</button>
                        </form>
                        <form action="/admin/avis/valider" method="POST" class="d-inline">
                          <input type="hidden" name="avis_id" value="<%= a._id %>">
                          <input type="hidden" name="action" value="refuser">
                          <button class="btn btn-danger btn-sm">❌ Refuser</button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer') %>

<style>
  .admin-avis-main {
    min-height: calc(100vh - 200px); /* espace pour le footer */
    background: #00ffbf;
  }
</style>
