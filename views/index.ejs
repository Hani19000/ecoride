<body>
    <!--Start header : le menu de le page-->
<%- include('partials/header', { user }) %>

        
    <!--End header-->
    
    <!--START BODY-->
    <main>
      <div class="wrapper">
        <section class="cover">
            <img id="image" src="assets/nature-suffocated-by-co2-pollution.jpg" />
            <div class="text">
                <h1>Voyagez ensemble de maniere durable tout en réduisant votre impact sur l'environnement.</h1>
                <p>EcoRide est une plateforme de covoiturage écoresponsable 
                    qui connecte conducteurs et passagers pour des trajets partagés.</p>
            </div>
        </section>
        </div>
    </main>
    <!--END BODY-->

<script>
  const qp = new URLSearchParams(location.search);
  const flash = document.getElementById('flash');

  if (qp.get('success') === 'reservation') {
    flash.innerHTML = '<div class="alert alert-success text-center">Réservation confirmée ✅ Un email vous a été envoyé.</div>';
  }
  if (qp.get('error') === 'reservation') {
    flash.innerHTML = '<div class="alert alert-danger text-center">❌ Erreur lors de la réservation. Vérifiez vos crédits et réessayez.</div>';
  }
</script>

<script>
  fetch('/api/me').then(r => r.json()).then(d => {
    if (d.user) {
      const span = document.querySelector('#credits');
      if (span) span.textContent = d.user.credits + ' crédits';
    }
  });
</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
<%- include('partials/footer') %>
</html>