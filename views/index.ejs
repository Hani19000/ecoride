<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <title>EcoRide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="style.css" />
    <script src="app.js"></script>
</head>

<body>
    <!--Start header : le menu de le page-->
<%- include('partials/header', { user }) %>

        
    <!--End header-->
    
    <!--START BODY-->
    <main>
      <div class="wrapper">
        <section class="cover">
            <img id="image" src="assets/nature-suffocated-by-co2-pollution.jpg" />
            <div class="text">
                <h1>Voyagez ensemble de maniere durable tout en réduisant votre impact sur l'environnement.</h1>
                <p>EcoRide est une plateforme de covoiturage écoresponsable 
                    qui connecte conducteurs et passagers pour des trajets partagés.</p>
            </div>
        </section>
        </div>
    </main>
    <!--END BODY-->

<script>
  const qp = new URLSearchParams(location.search);
  const flash = document.getElementById('flash');

  if (qp.get('success') === 'reservation') {
    flash.innerHTML = '<div class="alert alert-success text-center">Réservation confirmée ✅ Un email vous a été envoyé.</div>';
  }
  if (qp.get('error') === 'reservation') {
    flash.innerHTML = '<div class="alert alert-danger text-center">❌ Erreur lors de la réservation. Vérifiez vos crédits et réessayez.</div>';
  }
</script>

<script>
  fetch('/api/me').then(r => r.json()).then(d => {
    if (d.user) {
      const span = document.querySelector('#credits');
      if (span) span.textContent = d.user.credits + ' crédits';
    }
  });
</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
<%- include('partials/footer') %>
</html>